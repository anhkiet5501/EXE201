# ==============================================================================
# MIMO EDUCATION PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# 1. Ứng dụng & Môi trường runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ENABLE_SWAGGER=true
APPLY_MIGRATIONS=true

# 2. Local Database (Dùng cho Docker Compose cục bộ)
POSTGRES_DB=mimo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5433

# 3. Quản trị Cơ sở dữ liệu qua pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@mimo.app
PGADMIN_DEFAULT_PASSWORD=Admin123!
PGADMIN_PORT=5050

# 4. Chuỗi kết nối Database (EF Core Npgsql)
# - Dùng chung Supabase Cloud cho cả team (Session Pooler - Port 5432):
ConnectionStrings__DefaultConnection=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.axbejjdzsuelscpkuwab;Password=YOUR_DB_PASSWORD;Timeout=300;CommandTimeout=300;SSL Mode=Require;Trust Server Certificate=true
# - Hoặc dùng Local Postgres nếu muốn dev offline:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=mimo_db;Username=postgres;Password=123456

# 5. Redis Caching
# - Local:
ConnectionStrings__Redis=localhost:6379
# - Cloud Upstash Redis (nếu dùng):
# ConnectionStrings__Redis=YOUR_REDIS_ENDPOINT:6379,password=YOUR_PASSWORD,ssl=True,abortConnect=False

# 6. Bảo mật & Xác thực JWT
Jwt__Secret=GENERATE_A_RANDOM_STRING_AT_LEAST_32_CHARS
Jwt__Issuer=MimoAPI
Jwt__Audience=MimoClient

# 7. Cloud Storage (Supabase Storage)
Supabase__Url=https://axbejjdzsuelscpkuwab.supabase.co
Supabase__ApiKey=YOUR_SUPABASE_ANON_KEY
Supabase__BucketName=mimo-assets

# 8. Google OAuth (Đăng nhập Google)
GoogleAuth__ClientId=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# 9. Dịch vụ gửi Email (Gmail SMTP)
MailSettings__Server=smtp.gmail.com
MailSettings__Port=587
MailSettings__SenderEmail=noreply@mimo.app
MailSettings__Password=YOUR_APP_SPECIFIC_PASSWORD

# 10. Thanh toán chuyển khoản SePay (VietQR + webhook)
# ApiKey lấy ở SePay > Tích hợp WebHooks (xác thực API Key). KHÔNG commit giá trị thật.
SePay__ApiKey=YOUR_SEPAY_WEBHOOK_API_KEY
SePay__BankCode=TPBank
SePay__AccountNumber=YOUR_ACCOUNT_NUMBER
SePay__AccountName=YOUR_ACCOUNT_HOLDER_NAME
SePay__OrderPrefix=MIMO
SePay__OrderExpiryMinutes=30
